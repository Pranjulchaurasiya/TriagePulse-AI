# ==============================================================================
# TRIAGEPULSE AI · ENVIRONMENT CONFIGURATION & API KEYS
# ==============================================================================
# To run with live cloud providers:
#   1. Copy this file to .env:  copy .env.example .env
#   2. Add your API keys below.
#   3. Set MOCK_PROVIDERS=false.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVIDER MODE
# ------------------------------------------------------------------------------
# Set to 'false' to connect to live real-time cloud APIs.
# When 'true', the entire pipeline runs locally in simulation mode with zero keys.
MOCK_PROVIDERS=false

# ------------------------------------------------------------------------------
# 2. SPEECH-TO-TEXT (STT): DEEPGRAM
# ------------------------------------------------------------------------------
# Get key: https://console.deepgram.com/ ( free credit on signup)
# Model used: nova-2 (streaming bidirectional WebSocket, 16kHz linear16 PCM)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 3. CLINICAL REASONING (LLM): GROQ
# ------------------------------------------------------------------------------
# Get key: https://console.groq.com/ (Free tier available)
# Model used: llama-3.3-70b-versatile (Ultra-fast LPU inference, TTFT < 150ms)
# Alternative fast model: llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. TEXT-TO-SPEECH (TTS): CARTESIA OR ELEVENLABS
# ------------------------------------------------------------------------------
# Option A (Recommended for conversational latency): Cartesia Sonic (~90ms TTFB)
# Get key: https://play.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here

# Option B (Alternative): ElevenLabs Turbo v2.5
# Get key: https://elevenlabs.io/ (10,000 free characters/month)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# 5. SERVER NETWORK SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
