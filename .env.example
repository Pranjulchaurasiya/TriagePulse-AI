# TriagePulse-AI Configuration

# Set to "true" to use high-fidelity simulated/mock STT, LLM, and TTS (great for testing without API keys)
# Set to "false" to use live providers with keys below
MOCK_PROVIDERS=true

# Groq API (LLaMA 3.3 70B Versatile for sub-200ms TTFT)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram Nova-2 Streaming STT
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia Streaming TTS (or ElevenLabs)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# ElevenLabs Fallback
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
